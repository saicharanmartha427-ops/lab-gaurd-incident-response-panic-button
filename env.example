# Documentation placeholders only. SAM injects deployed resource names as Lambda environment variables.
AWS_REGION=ap-south-1
API_BASE_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com/prod
COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
NOTIFICATION_EMAIL=it-admin@example.edu
# Never put AWS access keys or private IoT certificates in frontend files.
